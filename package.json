{
  "name": "voice-feed",
  "version": "2.0.0",
  "private": true,
  "description": "Hands-free voice control for X (Twitter). Chrome/Edge extension, written in TypeScript.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "zip": "npm run build && node scripts/zip.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chrome": "^0.3.0",
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.70.1"
  }
}
